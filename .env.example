# Copy this file to .env and replace the placeholders.
# Never commit the real .env file.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=whatspoppin
DATABASE_USER=whatspoppin
DATABASE_PASSWORD=replace-with-your-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Optional local development without PostgreSQL:
# USE_SQLITE=1
# Browser origins allowed to call the API:
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Sign-up verification codes.
# Without these, codes are printed in the Django server console (DEBUG only).
# Email through SMTP:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=WhatsPoppin <no-reply@example.com>
