{
  "expo": {
    "name": "WhatsPoppin",
    "slug": "whatspoppin",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "whatspoppin",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whatspoppin.app"
    },
    "android": {
      "package": "com.whatspoppin.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04060A"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "WhatsPoppin \u00b7 Find your kind of night",
      "description": "Nearby bars, current crowd levels, and quick community reports.",
      "favicon": "./assets/favicon.png",
      "themeColor": "#620452"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#620452"
        }
      ]
    ]
  }
}
